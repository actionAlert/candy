end
do
	local now = os.time()
	for jobId, visitedAt in pairs(serverCache.Visited) do
		if now - (tonumber(visitedAt) or 0) > 45 * 60 then
			serverCache.Visited[jobId] = nil
		end
	end
	serverCache.Visited[game.JobId] = now
end
local farmState = {
	Farming = false,
	Status = "Idle",
	Here = { Candy = {}, Houses = 0 },
	Hopping = false,
}
local function updateElapsedTime(keepRunning)
	local now = os.time()
	local sessionMark = stats.Session.Mark
	local elapsedSeconds = sessionMark and math.max(0, now - sessionMark) or 0
	stats.Total.Seconds = stats.Total.Seconds + elapsedSeconds
	stats.Session.Seconds = stats.Session.Seconds + elapsedSeconds
	stats.Session.Mark = keepRunning and now or nil
	statsDirty = true
	return elapsedSeconds
end
local ui
-- FIX: ui is assigned `{}` before ui.Refresh exists, so always check the function, not just the table.
local function refreshUi()
	if ui and ui.Refresh then
		ui.Refresh()
	end
end
local function setStatus(statusText)
	farmState.Status = statusText
	if ui and ui.SetStatus then
		ui.SetStatus(statusText)
	end
end
local function recordCandyGains(gains)
	for candyName, amount in pairs(gains) do
		for bucketIndex, statsBucket in ipairs({ stats.Total, stats.Session, farmState.Here }) do
			statsBucket.Candy[candyName] = (statsBucket.Candy[candyName] or 0) + amount
		end
	end
	statsDirty = true
	refreshUi()
end
local function sumCounts(counts)
	local total = 0
	for countKey, amount in pairs(counts) do
		total = total + amount
	end
	return total
end
local function logEvent(...)
	if not storage.Ok then
		return
	end
	local logParts = { os.date("%H:%M:%S"), string.sub(game.JobId, 1, 8) }
	for argumentIndex, argument in ipairs({ ... }) do
		table.insert(logParts, tostring(argument))
	end
	local logLine = table.concat(logParts, " ") .. "\n"
	if type(executorApi.appendfile) == "function" then
		pcall(executorApi.appendfile, storage.path("candyfarm_log.txt"), logLine)
	end
end
if not config.Loop then
	pcall(executorApi.writefile, storage.path("candyfarm_log.txt"), "")
end
logEvent("start", "loop=" .. tostring(config.Loop))
local playerData = localPlayer:WaitForChild("Data", 30)
local function snapshotCandy()
	local snapshot = {}
	if playerData then
		for childIndex, dataValue in ipairs(playerData:GetChildren()) do
			if dataValue:IsA("IntValue") and isCandyName(dataValue.Name) then
				snapshot[dataValue.Name] = dataValue.Value
			end
		end
	end
	return snapshot
end
local function getCandyGains(before)
	local current, gains = snapshotCandy(), {}
	for candyName, currentAmount in pairs(current) do
		-- FIX: a candy type missing from the "before" snapshot counts from 0
		-- (previously it defaulted to currentAmount, so a first-ever pickup was ignored).
		local increase = currentAmount - (before[candyName] or 0)
		if increase > 0 then
			gains[candyName] = increase
		end
	end
	return gains
end
-- FIX: replaced the hard-coded ">= 50 children" check, which burned the full timeout
-- on every server if the Data folder ever had fewer than 50 children.
local minDataChildren = 1
local function waitForStableData(timeout)
	local startedAt = os.clock()
	playerData = playerData or localPlayer:WaitForChild("Data", timeout)
	if not playerData then
		return false
	end
	local function dataFingerprint()
		local fingerprint = #playerData:GetChildren()
		local goldValue = playerData:FindFirstChild("Gold")
		fingerprint = fingerprint * 7 + (goldValue and goldValue.Value or 0)
		for candyName, amount in pairs(snapshotCandy()) do
			fingerprint = fingerprint + #candyName * amount
		end
		return fingerprint
	end
	local previousFingerprint, lastChangedAt = dataFingerprint(), os.clock()
	while os.clock() - startedAt < timeout do
		task.wait(0.25)
		local currentFingerprint = dataFingerprint()
		if currentFingerprint ~= previousFingerprint then
			previousFingerprint, lastChangedAt = currentFingerprint, os.clock()
		elseif #playerData:GetChildren() >= minDataChildren and os.clock() - lastChangedAt >= 1.5 then
			return true
		end
	end
	return false
end
local function updateRewardPopups()
	pcall(function()
		local popupScript = localPlayer.PlayerGui.ItemGained.DisplayGainedItem.LocalScript
		popupScript.Disabled = config.HidePopups
		if config.HidePopups then
			for childIndex, popupGui in ipairs(popupScript:GetChildren()) do
				if popupGui:IsA("ScreenGui") then
					popupGui.Enabled = false
				end
			end
		end
	end)
end
local virtualUser = getService("VirtualUser")
trackConnection(localPlayer.Idled, function()
	if config.AntiAfk then
		pcall(function()
			virtualUser:CaptureController()
			virtualUser:ClickButton2(Vector2.new())
		end)
	end
end)
local claimedAttribute = "CF26Claimed"
local function getRootPart()
	local character = localPlayer.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end
local function findAndMarkHouseTriggers()
	local houses = workspace:FindFirstChild("Houses")
	local triggers = {}
	if not houses then
		return triggers
	end
	for houseIndex, house in ipairs(houses:GetChildren()) do
		-- FIX: GetPivot throws on non-Model children, so it is wrapped in pcall.
		local pivotOk, pivotCFrame = pcall(house.GetPivot, house)
		local isRaisedHouse = pivotOk and pivotCFrame.Position.Y > 20
		-- FIX: the claim mark is cleared once a house is lowered, so a reused house
		-- instance can be claimed again the next time it is raised.
		if pivotOk and not isRaisedHouse and house:GetAttribute(claimedAttribute) then
			house:SetAttribute(claimedAttribute, nil)
		end
		local doorTrigger = house:FindFirstChild("Door")
		doorTrigger = doorTrigger and doorTrigger:FindFirstChild("DoorInnerTouch")
			or house:FindFirstChild("DoorInnerTouch", true)
		if
			doorTrigger
			and doorTrigger:IsA("BasePart")
			and isRaisedHouse
			and not house:GetAttribute(claimedAttribute)
		then
			house:SetAttribute(claimedAttribute, true)
			table.insert(triggers, doorTrigger)
		end
		local giantHand = house:FindFirstChild("GiantHand")
		if giantHand then
			pcall(giantHand.Destroy, giantHand)
		end
	end
	return triggers
end
local function moveTriggersToRoot(triggers, rootPart)
	local heartbeatCount = 0
	local heartbeatConnection
	heartbeatConnection = runService.Heartbeat:Connect(function()
		heartbeatCount = heartbeatCount + 1
		for triggerIndex, doorTrigger in ipairs(triggers) do
			if doorTrigger.Parent then
				doorTrigger.CanCollide = false
				doorTrigger.Transparency = 1
				doorTrigger.CFrame = rootPart.CFrame
			end
		end
		if heartbeatCount > 20 or not scriptState.Alive then
			heartbeatConnection:Disconnect()
		end
	end)
end
local function touchAvailableHouses()
	local rootPart = getRootPart()
	if not rootPart then
		return 0
	end
	local triggers = findAndMarkHouseTriggers()
	if #triggers == 0 then
		return 0
	end
	updateRewardPopups()
	if type(executorApi.touch) == "function" then
		for triggerIndex, doorTrigger in ipairs(triggers) do
			pcall(executorApi.touch, rootPart, doorTrigger, 0)
		end
		task.wait()
		for triggerIndex, doorTrigger in ipairs(triggers) do
			pcall(executorApi.touch, rootPart, doorTrigger, 1)
		end
	else
		moveTriggersToRoot(triggers, rootPart)
	end
	farmState.Here.Houses = farmState.Here.Houses + #triggers
	stats.Total.Houses = stats.Total.Houses + #triggers
	stats.Session.Houses = stats.Session.Houses + #triggers
	statsDirty = true
	refreshUi()
	return #triggers
end
local function waitForCandyRewards(before, expectedCount, timeout)
	local startedAt = os.clock()
	local firstRewardAt
	while scriptState.Alive and os.clock() - startedAt < timeout do
		local receivedCount = sumCounts(getCandyGains(before))
		if receivedCount >= expectedCount then
			break
		end
		if receivedCount > 0 then
			firstRewardAt = firstRewardAt or os.clock()
			if os.clock() - firstRewardAt >= 1.5 then
				break
			end
		end
		task.wait(0.1)
	end
	local gains = getCandyGains(before)
	local receivedCount = sumCounts(gains)
	recordCandyGains(gains)
	local missingCount = math.max(0, expectedCount - receivedCount)
	logEvent(
		"rewards",
		"fired=" .. expectedCount,
		"got=" .. receivedCount,
		"fakes=" .. missingCount,
		string.format("%.1fs", os.clock() - startedAt)
	)
	stats.Total.Fakes = stats.Total.Fakes + missingCount
	stats.Session.Fakes = stats.Session.Fakes + missingCount
	statsDirty = true
	return receivedCount, missingCount
end
local function waitForHouses(timeout)
	local startedAt = os.clock()
	local houses = workspace:FindFirstChild("Houses")
	while not houses and os.clock() - startedAt < timeout do
		task.wait(0.25)
		houses = workspace:FindFirstChild("Houses")
	end
	if not houses then
		return nil
	end
	local previousCount, lastChangedAt = -1, os.clock()
	while os.clock() - startedAt < timeout do
		local houseCount = #houses:GetChildren()
		if houseCount ~= previousCount then
			previousCount, lastChangedAt = houseCount, os.clock()
		elseif houseCount >= 10 or houseCount > 0 and os.clock() - lastChangedAt > 1 then
			break
		end
		task.wait(0.1)
	end
	return houses
end
local fetchingServers = false
local serverCacheLifetime = 2 * 60
local serverPrefetchThreshold = 50
local function fetchServerPage(refresh)
	if fetchingServers or type(executorApi.request) ~= "function" then
		return false
	end
	fetchingServers = true
	local cursor = not refresh and serverCache.Cursor or nil
	local url = string.format(
		"https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100&excludeFullGames=true%s",
		placeId,
		cursor and "&cursor=" .. httpService:UrlEncode(cursor) or ""
	)
	local requestOk, response = pcall(executorApi.request, { Url = url, Method = "GET" })
	fetchingServers = false
	if not requestOk or type(response) ~= "table" then
		logEvent("servers", "request failed")
		return false
	end
	if response.StatusCode == 429 then
		logEvent("servers", "429 rate limited")
		return false, 429
	end
	local decodeOk, serverPage = pcall(httpService.JSONDecode, httpService, response.Body or "")
	if not decodeOk or type(serverPage) ~= "table" or type(serverPage.data) ~= "table" then
		serverCache.Cursor = nil
		logEvent("servers", "bad response", tostring(response.StatusCode))
		return false
	end
	if refresh then
		serverCache.List = {}
	end
	local knownServerIds = {}
	for serverIndex, server in ipairs(serverCache.List) do
		knownServerIds[server.id] = true
	end
	local addedCount = 0
	for serverIndex, server in ipairs(serverPage.data) do
		if
			type(server) == "table"
			and type(server.id) == "string"
			and tonumber(server.playing)
			and tonumber(server.maxPlayers)
			and server.playing < server.maxPlayers
			and not knownServerIds[server.id]
		then
			table.insert(serverCache.List, { id = server.id, playing = server.playing, max = server.maxPlayers })
			addedCount = addedCount + 1
		end
	end
	logEvent("servers", refresh and "refreshed" or "next page", "+" .. addedCount)
	serverCache.Cursor = serverPage.nextPageCursor
	serverCache.Fetched = os.time()
	saveServerCache()
	refreshUi()
	return true, addedCount
end
local function isServerCacheExpired()
	return os.time() - (tonumber(serverCache.Fetched) or 0) > serverCacheLifetime
end
local function countUnvisitedServers()
	local count = 0
	for serverIndex, server in ipairs(serverCache.List) do
		if not serverCache.Visited[server.id] then
			count = count + 1
		end
	end
	return count
end
local function takeNextServer()
	for attempt = 1, 6 do
		for selectionPass = 1, 2 do
			for serverIndex, server in ipairs(serverCache.List) do
				if
					server.id ~= game.JobId
					and not serverCache.Visited[server.id]
					and (selectionPass == 2 or (server.playing or 0) <= config.MaxPlayers)
				then
					table.remove(serverCache.List, serverIndex)
					saveServerCache()
					return server
				end
			end
		end
		setStatus("Fetching servers...")
		local fetched, fetchResult = fetchServerPage(#serverCache.List == 0 or isServerCacheExpired())
		if not fetched then
			task.wait(fetchResult == 429 and 4 * attempt or 2)
		end
	end
	return nil
end
local function prefetchServers()
	if isServerCacheExpired() then
		task.spawn(fetchServerPage, true)
	elseif countUnvisitedServers() < serverPrefetchThreshold then
		task.spawn(fetchServerPage, false)
	end
end
local function buildTeleportBootstrap()
	local cachedScriptPath = storage.path("CandyFarm2026.lua")
	return string.format(
		"if not game:IsLoaded() then game.Loaded:Wait() end "
			.. "getgenv().CandyFarm2026FromHop=true "
			.. "local p=%q local ok,src=pcall(readfile,p) "
			.. "if not (ok and type(src)=='string' and #src>0) then src=game:HttpGet(%q) end "
			.. "loadstring(src)()",
		cachedScriptPath,
		sourceUrl
	)
end
local sourceCacheLifetime = 24 * 60 * 60
local function cacheScriptSource()
	if not storage.Ok or environment.CandyFarm2026Source == false then
		return
	end
	local providedSource = environment.CandyFarm2026Source
	local sourceAge = os.time() - (tonumber(config.SourceFetched) or 0)
	if type(providedSource) ~= "string" and storage.exists("CandyFarm2026.lua") and sourceAge < sourceCacheLifetime then
		return
	end
	task.spawn(function()
		local source = providedSource
		if type(source) ~= "string" then
			local downloadOk, downloadedSource = pcall(game.HttpGet, game, sourceUrl)
			source = downloadOk and downloadedSource or nil
		end
		if type(source) == "string" and source:find("CandyFarm2026", 1, true) then
			if pcall(executorApi.writefile, storage.path("CandyFarm2026.lua"), source) then
				config.SourceFetched = os.time()
				saveConfig()
				logEvent("source", type(providedSource) == "string" and "dev copy" or "downloaded", #source .. " bytes")
			end
		else
			lo
