local function isCandyName(itemName)
	return itemName:sub(1, 5) == "Candy" and itemName ~= "CandyCaneSwordMount"
end
local storage = {
	Root = "_luau.pro/Games/Build A Boat For Treasure/strings",
	Ok = type(executorApi.writefile) == "function" and type(executorApi.readfile) == "function" and type(
		executorApi.isfolder
	) == "function" and type(executorApi.makefolder) == "function",
}
function storage.path(filename)
	return storage.Root .. "/" .. filename
end
function storage.ensure()
	if not storage.Ok then
		return false
	end
	local currentPath = ""
	for pathSegment in storage.Root:gmatch("[^/]+") do
		currentPath = currentPath == "" and pathSegment or currentPath .. "/" .. pathSegment
		local folderCheckOk, folderExists = pcall(executorApi.isfolder, currentPath)
		if not (folderCheckOk and folderExists) then
			if not pcall(executorApi.makefolder, currentPath) then
				storage.Ok = false
				return false
			end
		end
	end
	return true
end
function storage.exists(filename)
	if not storage.Ok then
		return false
	end
	if type(executorApi.isfile) == "function" then
		local fileCheckOk, fileExists = pcall(executorApi.isfile, storage.path(filename))
		return fileCheckOk and fileExists == true
	end
	local readOk, contents = pcall(executorApi.readfile, storage.path(filename))
	return readOk and type(contents) == "string"
end
function storage.readJSON(filename)
	if not storage.exists(filename) then
		return nil
	end
	local readOk, jsonText = pcall(executorApi.readfile, storage.path(filename))
	if not readOk or type(jsonText) ~= "string" or jsonText == "" then
		return nil
	end
	local decodeOk, decoded = pcall(httpService.JSONDecode, httpService, jsonText)
	return decodeOk and type(decoded) == "table" and decoded or nil
end
function storage.writeJSON(filename, data)
	if not storage.Ok then
		return false
	end
	local encodeOk, jsonText = pcall(httpService.JSONEncode, httpService, data)
	return encodeOk and pcall(executorApi.writefile, storage.path(filename), jsonText)
end
storage.ensure()
