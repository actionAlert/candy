local function newStatsBucket()
	return {
		Candy = {},
		Houses = 0,
		Fakes = 0,
		Servers = 0,
		Seconds = 0,
		Started = os.time(),
	}
end
local function normalizeStatsBucket(statsBucket)
	statsBucket.Candy = statsBucket.Candy or {}
	statsBucket.Houses = statsBucket.Houses or 0
	statsBucket.Fakes = statsBucket.Fakes or 0
	statsBucket.Servers = statsBucket.Servers or 0
	statsBucket.Seconds = statsBucket.Seconds or 0
	statsBucket.Started = statsBucket.Started or os.time()
	return statsBucket
end
normalizeStatsBucket(stats.Total)
normalizeStatsBucket(stats.Session)
-- FIX: removed the third-party scriptblox.com loadstring. It ran unverified remote code
